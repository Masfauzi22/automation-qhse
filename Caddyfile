{
	# Vercel sudah menangani HTTPS di depan container, jadi Caddy cukup HTTP biasa
	auto_https off
}

:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	# File CSS/JS hasil `npm run build` punya nama unik (hash), aman di-cache 1 tahun
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Laravel tidak butuh header ini; disembunyikan supaya versi server tidak terlihat
	header -Server
	header -X-Powered-By

	php_server {
		try_files {path} index.php
	}
}
